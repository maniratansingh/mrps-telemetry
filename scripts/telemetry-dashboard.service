[Unit]
Description=MRPS telemetry dashboard
Documentation=https://mrps.in
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/telemetry-dashboard
ExecStart=%h/nodejs/bin/node %h/telemetry-dashboard/server/server.mjs
Environment=PORT=4310
Environment=API_ORIGIN=http://127.0.0.1:43871
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
