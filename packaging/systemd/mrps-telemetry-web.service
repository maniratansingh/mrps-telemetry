[Unit]
Description=MRPS telemetry dashboard
Documentation=https://mrps.in
After=network-online.target mrps-telemetry-api.service
Wants=network-online.target mrps-telemetry-api.service

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/mrps-telemetry/web
ExecStart=/usr/bin/node /opt/mrps-telemetry/web/server/server.mjs
EnvironmentFile=-/etc/default/mrps-telemetry-web
Environment=STATIC_ROOT=/opt/mrps-telemetry/web/dist
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
