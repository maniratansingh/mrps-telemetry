[Unit]
Description=Serve the local MRPS APT repository (Go)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/apt-repo-server
ExecStart=%h/apt-repo-server/mrps-repo
Environment=PORT=8090
Environment=ROOT=%h/apt-repo
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
